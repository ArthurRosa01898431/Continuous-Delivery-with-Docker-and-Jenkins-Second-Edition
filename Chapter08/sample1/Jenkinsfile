pipeline {
    // agent { label 'docker-agent' }

    // agent {
    //       label 'docker-agent'
    //  }  

    agent {
        docker {
            image 'gradle:jdk8'
            args '--network=host'
        }
    }

    stages {

        stage('Start Containers') {
            steps {
                sh "docker run -d --name hazelcast  --network jenkins-network hazelcast/hazelcast:3.12"
                sh "docker run -d --name calculator -p 8082:8082  --network jenkins-network localhost:5001/calculator-feature:0.1"
                sh "sleep 10"
            }
        }

        stage('Test Calculator') {
            steps {
                sh '''
                
                echo "Testing Correct Division"
                result=$(curl "localhost:8080/div?a=6&b=1")
                if [ "$result" -eq 6 ]; then
                    echo 'pass'
                else
                    echo 'fail'
                fi

                echo "Testing Incorrect Division"
                result=$(curl "localhost:8080/div?a=6&b=2")
                if [ "$result" -eq 3 ]; then
                    echo 'pass'
                else
                    echo 'fail'
                fi

                echo "Testing Divide by 0"
                read result=$(curl "localhost:8080/div?a=6&b=0")
                if [[ "$result" == "Division by 0" ]]; then
                    echo "pass"
                else
                    echo "fail"
                fi
                '''
            }
        }
    }
    post {
        failure {
            echo 'The pipeline failed.'
        }
        always {
           script {

            sh """
            docker stop calculator hazelcast
            docker rm calculator hazelcast

            """

           }
        }
    }
}