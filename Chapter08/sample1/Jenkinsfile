        stage('Test Calculator') {
            steps {
                sh '''
                
                echo "Testing Correct Division"
                result=$(curl --insecure "localhost:8082/div?a=6&b=1")
                if [ "$result" -eq 6 ]; then
                    echo 'pass'
                else
                    echo 'fail'
                fi

                echo "Testing Incorrect Division"
                result=$(curl --insecure "http://localhost:8082/div?a=6&b=2")
                if [ "$result" -eq 3 ]; then
                    echo 'pass'
                else
                    echo 'fail'
                fi

                echo "Testing Divide by 0"
                read result < <(curl --insecure "http://localhost:8082/div?a=6&b=0")
                if [[ "$result" == "Division by 0" ]]; then
                    echo "pass"
                else
                    echo "fail"
                fi
                '''
