pipeline {
    // agent { label 'docker-agent' }

    agent any

    environment {
        REGISTRY = "localhost:5001"
    }

    stages {
        stage('Check Branch') {
            steps {
                script {
                    def branchName = env.BRANCH_NAME

                    if (branchName == 'main1') {
                        echo "Running main branch pipeline..."
                        env.RUN_MAIN = 'true'
                        env.RUN_PLAYGROUND = 'false'
                        env.IMAGE_NAME = 'calculator'
                        env.IMAGE_TAG= '1.0'
                    } else if (branchName == 'Exercise9') {
                        echo "Running Feature branch pipeline..."
                        env.RUN_FEATURE = 'true'
                        env.RUN_PLAYGROUND = 'false'
                        env.IMAGE_NAME = 'calculator-feature'
                        env.IMAGE_TAG= '0.1'
                    } 

                    if (branchName == 'playground') {
                        echo "Running playground branch pipeline..."
                        env.RUN_PLAYGROUND = 'true'
                    }
                }
            }
        }

        stage('Code coverage') {
            when {
                expression { env.RUN_MAIN == 'true' } 
            }
            steps {
                sh """
                cd Chapter08/sample1
                chmod +x gradlew
                ./gradlew jacocoTestReport
                ./gradlew jacocoTestCoverageVerification
                """
            }
        }

        // stage('Compile') {
        //     steps {
        //             sh """
        //             cd Chapter09/sample3
        //             chmod +x gradlew
        //             ./gradlew compileJava
        //             """
        //        }
        // }

        // stage('Unit test') {
        //     steps {
        //             sh """
        //             cd Chapter09/sample3
        //             chmod +x gradlew
        //             ./gradlew test
        //             """
        //        }
        // }
        
        // stage('Static code analysis') {
        //     steps {
        //             sh """
        //             cd Chapter09/sample3
        //             chmod +x gradlew
        //             ./gradlew checkstyleMain
        //             """
        //        }
        // }

        stage('Package') {
            steps {
                    sh """
                    cd Chapter08/sample1
                    chmod +x gradlew
                    ./gradlew build
                

                    """
               }
        }
    }
    post {
        success {
            script {
                if (env.RUN_PLAYGROUND == 'false') {
                    echo 'Running container'
                    sh """ 
                    cd Chapter08/sample1
                    docker build -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} .
                    """
                    withCredentials([usernamePassword(credentialsId: 'docker-registry', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
                        sh "docker login ${REGISTRY} --username $USERNAME --password $PASSWORD"
                    }
                    sh "docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
                    
                }
                echo 'The pipeline ran successfully!'
            }
        }
        failure {
            echo 'The pipeline failed.'
        }
        // always {
        //     publishHTML([
        //         target: [
        //             reportDir: 'Chapter08/sample1/build/reports/checkstyle',
        //             reportFiles: 'index.html',
        //             reportName: "jacoco checkstyle"
        //         ]
        //     ])
        // }
    }
}