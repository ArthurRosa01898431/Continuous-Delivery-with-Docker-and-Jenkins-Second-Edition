pipeline {
    agent {
        label 'docker-agent'
    }

    stages {
        stage("Compile") {
            steps {
                sh '''
                cd Chapter08/sample1
                chmod +x gradlew
                ./gradlew compileJava
                '''
            }
        }
        stage("Unit test") {
            steps {
                sh '''
                cd Chapter08/sample1
                chmod +x gradlew
                ./gradlew test
                '''
            }
        }
        stage("Code coverage") {
            steps {
                sh '''
                 cd Chapter08/sample1
                 chmod +x gradlew
                ./gradlew jacocoTestReport
                ./gradlew jacocoTestCoverageVerification
                '''
            }
        }
        stage("Static code analysis") {
            steps {
                sh '''
                cd Chapter08/sample1
                chmod +x gradlew
                ./gradlew checkstyleMain
                '''
            }
        }
        stage("Package") {
            steps {
                sh '''
                cd Chapter08/sample1
                chmod +x gradlew
                ./gradlew build
                '''
            }
        }

        stage("Docker build") {
            steps {
                sh '''
                cd Chapter08/sample1
                docker build -t arosa/calculator:1.0.0 .
                docker tag arosa/calculator:1.0.0 localhost:5001/arosa/calculator:1.0.0
                '''
            }
        }

        stage("Docker login") {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-registry', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
                    sh """
                    docker login localhost:5001 -u $USERNAME -p $PASSWORD
                    """
                }
            }
        }

        stage("Docker push") {
            steps {
                sh "docker push localhost:5001/arosa/calculator:1.0.0"
            }
        }


        stage("Deploy to staging") {
            steps {
                sh '''
                cd Chapter08/sample1
                kubectl config use-context docker-desktop
                kubectl apply -f hazelcast.yaml
                kubectl apply -f calculator.yaml
                '''
            }
        }

        stage("Acceptance test") {
               steps {
                sh '''
                    cd Chapter08/sample1
                    chmod +x acceptance-test.sh
                    ./acceptance-test.sh
                '''
               }
          }

        stage("Release") {
            steps {
                sh '''
                cd Chapter08/sample1
                kubectl config use-context gke_devops-exersise-11_us-central1_hello-cluster
                kubectl apply -f hazelcast.yaml
                kubectl apply -f calculator.yaml
                '''
            }
        }

        stage("Smoke test") {
            steps {
                sleep 60
                sh '''
                    cd Chapter08/sample1
                    chmod +x smoke-test.sh
                    ./smoke-test.sh
                '''              
            }
        }
    }  
}
